# /watch API configuration
#
# Copy this file to ~/.config/watch/.env and fill in your keys.
# Choose ONE Whisper backend:
#
# 0. Local (recommended for China users) — offline faster-whisper on CPU:
#    WHISPER_BACKEND=local
#    WHISPER_MODEL=small           # tiny / base / small / medium / large-v3
#
# 1. Custom — any OpenAI-compatible ASR endpoint:
#    WHISPER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
#    WHISPER_API_KEY=your_key
#    WHISPER_MODEL=sensevoice-v1
#
# 2. Groq (free tier, fast):      https://console.groq.com/keys
#    GROQ_API_KEY=your_key
#
# 3. OpenAI:                       https://platform.openai.com/api-keys
#    OPENAI_API_KEY=your_key

WHISPER_BACKEND=
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
GROQ_API_KEY=
OPENAI_API_KEY=

# Default watch behavior
# Allowed values: transcript | efficient | balanced | token-burner
WATCH_DETAIL=balanced
